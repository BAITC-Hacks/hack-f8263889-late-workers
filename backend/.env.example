# --- App ---
ENV=dev
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# --- Database ---
# Postgres in Docker: `make infra`. Host port is 5439, not 5432 — a local Postgres
# install usually owns 5432 and the app would silently connect to it instead.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5439/app
# Tests run against their own database on the same container; `make test` creates it.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5439/app_test
AUTO_MIGRATE=true

# --- Redis (optional: rate limiting for AI endpoints; leave unset to disable) ---
REDIS_URL=redis://localhost:6379/0
AI_RATE_LIMIT_PER_MINUTE=20

# --- Auth (generate: openssl rand -hex 32) ---
SECRET_KEY=change-me-to-a-random-64-char-hex-string-see-env-example
# Token lifetime; the auth cookie's Max-Age is derived from it. 10080 = 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# "Lax" works when the API and the web app share a host (localhost counts, ports don't).
# Cross-domain production (api.example.com + app.vercel.app) needs "None" plus ENV=prod.
AUTH_COOKIE_SAMESITE=Lax

# --- AI (OpenAI) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-proxy.example.com/v1   # only if the organizers give you a proxy
OPENAI_MODEL=gpt-5.5
OPENAI_MAX_OUTPUT_TOKENS=4096
# OPENAI_REASONING_EFFORT=low   # none|minimal|low|medium|high|xhigh|max; unset = provider default
AI_SYSTEM_PROMPT=You are a helpful assistant. Answer concisely.
AI_TIMEOUT_SECONDS=30
AI_HOURLY_LIMIT_PER_BUSINESS=30
