# Use FastAPI for authentication and the catalog by default.
# Set true for standalone development with in-memory mocks (dev only).
AUTH_MOCKS=false

# /api is forwarded unchanged, including Set-Cookie response headers.
# In Docker Compose the target is http://api:8000.
API_PROXY_TARGET=http://127.0.0.1:8000

# Build environment tag — one of: development | staging | production
VITE_APP_ENV=development
