# Development authentication API with HttpOnly cookies and in-memory accounts.
# Restarting Vite resets mock accounts and sessions. Ignored in build/preview.
AUTH_MOCKS=true

# Set AUTH_MOCKS=false to use the real backend. /api is forwarded unchanged.
# In Docker Compose the target is http://api:8000.
API_PROXY_TARGET=http://localhost:8000

# Build environment tag — one of: development | staging | production
VITE_APP_ENV=development
